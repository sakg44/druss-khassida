{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/logo.svg",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "static-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/icons/**",
          "/**/*.svg",
          "/**/*.png"
        ],
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "khassida-data",
      "urls": ["/assets/data/**"],
      "cacheConfig": {
        "maxSize": 30,
        "maxAge": "7d",
        "strategy": "performance"
      }
    },
    {
      "name": "audio-r2",
      "urls": ["https://pub-308c3cf97a1f4e37b3352d14d3eb7b76.r2.dev/**"],
      "cacheConfig": {
        "maxSize": 300,
        "maxAge": "30d",
        "timeout": "10s",
        "strategy": "performance"
      }
    }
  ]
}
